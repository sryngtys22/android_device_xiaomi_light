# Charger
ro.charger.enable_suspend=true

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# IMS
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1

# Zygote
zygote.critical_window.minute=10

#About Phone
ro.product.marketname=Redmi 10 5G
ro.infinity.soc=Dimensity 700
ro.infinity.battery=4900 mAh
ro.infinity.display=1080 x 2408, 120 Hz
ro.infinity.camera=50MP
